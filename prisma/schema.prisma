generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// HYghLights owns its OWN database for community/highlights data. Accounts are
// SHARED with Beyond Limits: auth verifies against that shared `User` table via
// src/lib/identity.ts (a separate connection), so the same email + password
// works on both. Rows here reference the shared account by `userId` + `email`
// (no cross-database foreign key).

// One row per member — their ritual settings + streak state.
model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  email           String
  displayName     String?
  peacePlace      String? // where they reflect (nature, the ocean, a closet…)
  celebrationSong String? // a YouTube link that plays when they celebrate
  onboardedAt     DateTime?
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastEntryDate   DateTime? // the day (UTC midnight) of their most recent highlight

  /// Their why, in their words. The Y in hYghlights is *why* — the question the
  /// whole product asks — so it is the one thing the card leads with.
  why             String?

  /// The public card. OFF until the member turns it on: this is a private,
  /// invite-only community, and nothing anybody already wrote becomes visible
  /// to strangers because a feature shipped.
  cardPublic      Boolean   @default(false)
  /// firstname-lastname, numbered on collision. Issued once and never rewritten
  /// — a shared link that stops working is worse than an imperfect slug.
  cardSlug        String?   @unique

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  @@index([email])
  @@index([cardPublic])
}

// A single highlight / celebration / memory, filed to a day and a life category.
model Highlight {
  id        String   @id @default(cuid())
  userId    String
  email     String
  entryDate DateTime // the day this highlight is "for" (UTC midnight)
  category  String // one of the 8 life categories — see src/lib/categories.ts
  text      String
  photoUrl  String?
  videoUrl  String?
  inJar     Boolean  @default(false) // dragged into that month's jar

  /// Cleared for the member's public card. Per-highlight and opt-in, because
  /// every one of these was written inside a members-only room. A card shows
  /// only what its owner has ticked, one win at a time.
  isShareable Boolean @default(false)

  createdAt DateTime @default(now())

  reactions Reaction[]

  @@index([userId, entryDate])
  @@index([category])
}

// Celebrate each other: high-fives, balloons, dance parties.
model Reaction {
  id          String    @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromEmail   String
  type        String // HIGHFIVE | BALLOON | DANCEPARTY
  createdAt   DateTime  @default(now())

  @@unique([highlightId, fromUserId, type])
  @@index([highlightId])
}

// Small groups / networks of family, friends, or business partners.
model Group {
  id         String        @id @default(cuid())
  name       String
  ownerId    String
  inviteCode String        @unique
  createdAt  DateTime      @default(now())
  members    GroupMember[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  email    String
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// iThrive whole-person review — a snapshot of self-scores (0–10) across the
// 8 pillars, taken weekly/monthly/quarterly/annually to measure progress.
model PillarReview {
  id        String   @id @default(cuid())
  userId    String
  email     String
  period    String   @default("adhoc") // weekly | monthly | quarterly | annual | adhoc
  scores    Json // { HEALTH: 7, CAREER: 6, ... } (0–10 per pillar)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Self-assessment results (communication, love language, leadership, …). One
// current result per quiz per member; retaking updates it.
model Assessment {
  id          String   @id @default(cuid())
  userId      String
  email       String
  quizKey     String
  resultKey   String
  resultLabel String
  completedAt DateTime @default(now())

  @@unique([userId, quizKey])
  @@index([userId])
  @@index([quizKey])
}

// Weekly review — end-of-week self-scores across the 6 execution areas
// (workouts, nutrition, hydration, priorities, accomplishments, sleep).
model WeeklyReview {
  id        String   @id @default(cuid())
  userId    String
  email     String
  scores    Json // { WORKOUTS: 8, NUTRITION: 6, ... } (0–10)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Spinning Plates — projects / follow-ups you're keeping in the air. Completed
// plates roll up into the Master Accomplishment list.
model Plate {
  id          String    @id @default(cuid())
  userId      String
  email       String
  title       String
  category    String?
  status      String    @default("active") // active | done
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId, status])
}

// Message in a bottle 🌊 — a sentimental note of inspiration floated through the
// ocean to a friend (by email). They open it like a message in a bottle.
model Bottle {
  id         String    @id @default(cuid())
  fromUserId String
  fromEmail  String
  fromName   String?
  toEmail    String
  message    String
  photoUrl   String?
  openedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([toEmail])
  @@index([fromUserId])
}

/// A browser that has signed in and is trusted to stay signed in.
///
/// A ninety-day session is only responsible if it can be ended early. JWTs are
/// stateless and cannot be revoked on their own, so every session carries the id
/// of one of these rows and every request checks it is still live. That is one
/// indexed read per request, and it is what buys the ability to sign out a
/// stolen laptop from your own settings page.
///
/// It is also the record that makes a new sign-in noticeable: a device nobody
/// recognises is the first sign that a password has gone astray.
model Device {
  id         String   @id @default(cuid())
  userId     String
  /// "Chrome on macOS" — parsed from the user agent, for the member to
  /// recognise, never for fingerprinting.
  label      String
  /// Coarse, and shown only to the member whose device it is. Never used to
  /// decide whether a session is valid: IP addresses change on every move
  /// between wifi and cellular, and binding a session to one would sign people
  /// out several times a day.
  lastIp     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Set when the member signs this device out from somewhere else.
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}
